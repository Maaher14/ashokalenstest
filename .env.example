# Set these as environment variables; Flask does not auto-load this file without python-dotenv.
# Local execution uses local storage and Google login by default.
GOOGLE_CLIENT_ID=176502342331-4ge9mjsg63u0mvrfic6bulrplrj5jdt9.apps.googleusercontent.com
STORAGE=local
LENS_DATA=./instance
DEMO_MODE=0
PRODUCTION=0
# Production: STORAGE=s3, PRODUCTION=1, DEMO_MODE=0 and persistent LENS_DATA.
S3_BUCKET=ashoka-lens-media
AWS_REGION=ap-southeast-2
